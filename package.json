  },
  "type": "module",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build": "tsc --project tsconfig.json",
    "validateBuild": "tsc --project tsconfig.json --noEmit",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "npm run lint && npm run validateBuild && node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.12.0",
    "@azure/msal-node": "^5.1.1",
    "@vestfoldfylke/loglady": "^1.5.3",
    "node-cache": "^5.1.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
